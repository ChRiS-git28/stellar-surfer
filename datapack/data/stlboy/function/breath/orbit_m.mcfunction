# Place les etoiles puis oriente les traits (macro, en tant que la cible)
$execute rotated $(ang) 0 run tp @e[type=minecraft:item_display,tag=stlboy_s1,tag=!stlboy_cdone,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] ^$(x1) ^$(y1) ^$(z1)
$execute rotated $(ang) 0 run tp @e[type=minecraft:item_display,tag=stlboy_s2,tag=!stlboy_cdone,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] ^$(x2) ^$(y2) ^$(z2)
