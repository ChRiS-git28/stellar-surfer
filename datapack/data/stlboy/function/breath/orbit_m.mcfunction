$execute as @e[type=minecraft:item_display,tag=stlboy_l1,tag=!stlboy_cdone,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] at @e[type=minecraft:item_display,tag=stlboy_s1,tag=!stlboy_cdone,scores={stlboy.cid=$(cid)},limit=1,predicate=stlboy:owned] facing entity @e[type=minecraft:item_display,tag=stlboy_s2,tag=!stlboy_cdone,scores={stlboy.cid=$(cid)},limit=1,predicate=stlboy:owned] feet positioned ^ ^ ^$(h1) run tp @s ~ ~ ~ ~ ~
