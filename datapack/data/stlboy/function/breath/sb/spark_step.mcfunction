$execute if predicate stlboy:chance_quarter run particle apoli:custom{texture:"stlboy:textures/particle/twinkle.png",lifetime:6,lifetime_variation:3,size:0.14f,size_variation:0.05f,end_size:0.0f,color:"#FFFFFFFF",end_color:"$(c)00",friction:0.9f,gravity:0.0f,physics:false,emissive:true,blend:"translucent",easing:"ease_out_quad",roll:"rUni(0, 360)",roll_speed:"rNor(0, 4)"} ^ ^ ^ 0.2 0.2 0.2 0.1 1 force
scoreboard players remove #sn stlboy.tmp 1
$execute if score #sn stlboy.tmp matches 1.. positioned ^ ^ ^1.5 run function stlboy:breath/sb/spark_step {c:"$(c)",d:"$(d)"}
