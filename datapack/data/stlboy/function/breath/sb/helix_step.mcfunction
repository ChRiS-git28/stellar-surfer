# Un point de chaque brin de l'helice (macro c/d = couleurs de la palette), puis 1,5 bloc plus loin
scoreboard players add #hk stlboy.tmp 1
scoreboard players operation #hp stlboy.tmp = #hk stlboy.tmp
scoreboard players operation #hp stlboy.tmp %= #c8 stlboy.tmp
$execute if score #hp stlboy.tmp matches 0 run particle apoli:custom{texture:"stlboy:textures/particle/twinkle.png",lifetime:7,lifetime_variation:2,size:0.12f,size_variation:0.05f,end_size:0.0f,color:"$(c)FF",end_color:"$(d)00",friction:1.0f,gravity:0.0f,physics:false,emissive:true,blend:"translucent",easing:"ease_out_quad"} ^0.42 ^0.00 ^ 0 0 0 0 1 force
