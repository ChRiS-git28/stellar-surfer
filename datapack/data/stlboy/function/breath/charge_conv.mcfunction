# Charge du Souffle : des etincelles naissent sur une sphere autour de la main et convergent en un point (genere par chargeconv.py)
# (en tant que le joueur, positionne au point de convergence)
scoreboard players set #cp stlboy.tmp 1
execute if score @s stlboy.pal matches 2..5 run scoreboard players operation #cp stlboy.tmp = @s stlboy.pal
execute store result score #ci stlboy.tmp run time query gametime
scoreboard players set #c16 stlboy.tmp 16
scoreboard players operation #ci stlboy.tmp %= #c16 stlboy.tmp
