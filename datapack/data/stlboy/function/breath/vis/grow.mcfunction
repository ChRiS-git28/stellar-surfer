# Croissance fluide des etoiles et des traits nes au tick precedent (macro)
$execute as @e[type=minecraft:item_display,tag=stlboy_cstar,tag=stlboy_grow1,scores={stlboy.cid=$(cid)}] run data merge entity @s {start_interpolation:0,interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[$(s)f,$(s)f,$(s)f]}}
$execute as @e[type=minecraft:item_display,tag=stlboy_l1,tag=stlboy_grow1,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] run data merge entity @s {start_interpolation:0,interpolation_duration:6,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[$(t)f,$(t)f,$(d1)f]}}
$execute as @e[type=minecraft:item_display,tag=stlboy_l2,tag=stlboy_grow1,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] run data merge entity @s {start_interpolation:0,interpolation_duration:6,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[$(t)f,$(t)f,$(d2)f]}}
$execute as @e[type=minecraft:item_display,tag=stlboy_l3,tag=stlboy_grow1,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] run data merge entity @s {start_interpolation:0,interpolation_duration:6,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[$(t)f,$(t)f,$(d3)f]}}
$execute as @e[type=minecraft:item_display,tag=stlboy_l4,tag=stlboy_grow1,scores={stlboy.cid=$(cid)},predicate=stlboy:owned] run data merge entity @s {start_interpolation:0,interpolation_duration:6,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[$(t)f,$(t)f,$(d4)f]}}
