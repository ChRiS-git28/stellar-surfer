      "change": 2,
      "operation": "set"
     }
    },
    {
     "condition": {
      "type": "apoli:attribute",
      "attribute": "minecraft:generic.armor",
      "comparison": ">=",
      "compare_to": 4
     },
     "action": {
      "type": "apoli:change_resource",
      "resource": "stlboy:starfrag_weight",
      "change": 1,
      "operation": "set"
     }
    },
    {
     "condition": {
      "type": "apoli:attribute",
      "attribute": "minecraft:generic.armor",
      "comparison": "<",
      "compare_to": 4
     },
     "action": {
      "type": "apoli:change_resource",
      "resource": "stlboy:starfrag_weight",
      "change": 0,
      "operation": "set"
     }
    }
   ]
  }
 },
