{
 "type": "apoli:multiple",
 "name": "Stellar Fragility",
 "description": "§7§oYour astral body is too light to bear the burdens of mortals. Metal chains you to the ground, and every plate of armor is an §8§oanchor§7§o dragging you from the sky.",
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/armor.png",
   "text": "§7Every §f4 armor points§7 add §cWeight§7 (max 5, at 20 armor)."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": "§cWeight§7 makes you §csink§7 when idle and slows your climb."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/info.png",
   "text": "§7Each point of §cWeight§7: §c-10%§7 movement, in float and in flight."
  }
 ],
 "weight": {
  "type": "apoli:resource",
  "min": 0,
  "max": 5,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "weigh": {
  "type": "apoli:action_over_time",
  "interval": 10,
  "entity_action": {
   "type": "apoli:if_else_list",
   "actions": [
    {
     "condition": {
      "type": "apoli:attribute",
      "attribute": "minecraft:generic.armor",
      "comparison": ">=",
      "compare_to": 20
     },
     "action": {
      "type": "apoli:change_resource",
      "resource": "stlboy:starfrag_weight",
      "change": 5,
      "operation": "set"
     }
    },
    {
     "condition": {
      "type": "apoli:attribute",
      "attribute": "minecraft:generic.armor",
      "comparison": ">=",
      "compare_to": 16
     },
     "action": {
