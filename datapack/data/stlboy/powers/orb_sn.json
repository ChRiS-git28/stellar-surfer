{
 "type": "apoli:multiple",
 "hidden": true,
 "name": "Wormhole",
 "description": "A dying star, frozen at the moment it bursts.",
 "age": {
  "type": "apoli:resource",
  "min": 0,
  "max": 20,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "age_tick": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:orb_sn_age",
   "comparison": "<",
   "compare_to": 20
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:orb_sn_age",
   "change": 1,
   "operation": "add"
  }
 },
 "anchor": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "execute at @e[type=minecraft:marker,tag=stlboy_sn,limit=1] run tp @s ~ ~-0.6 ~"
    },
    {
     "type": "apoli:if_else",
     "condition": {
      "type": "apoli:and",
      "conditions": [
       {
        "type": "apoli:resource",
        "resource": "stlboy:orb_sn_dying",
        "comparison": "==",
        "compare_to": 0
       },
       {
        "type": "apoli:command",
        "command": "execute unless entity @e[type=minecraft:marker,tag=stlboy_sn]",
        "comparison": ">=",
        "compare_to": 1
       }
      ]
     },
     "if_action": {
      "type": "apoli:change_resource",
      "resource": "stlboy:orb_sn_dying",
      "change": 1,
      "operation": "set"
     }
    }
   ]
  }
 },
 "dying": {
  "type": "apoli:resource",
  "min": 0,
  "max": 20,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "dying_tick": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:orb_sn_dying",
   "comparison": ">",
   "compare_to": 0
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:change_resource",
     "resource": "stlboy:orb_sn_dying",
     "change": 1,
     "operation": "add"
    },
    {
     "type": "apoli:if_else",
     "condition": {
      "type": "apoli:resource",
      "resource": "stlboy:orb_sn_dying",
      "comparison": ">=",
      "compare_to": 12
     },
     "if_action": {
      "type": "apoli:execute_command",
      "command": "kill @s"
     }
    }
   ]
  }
 }
}
