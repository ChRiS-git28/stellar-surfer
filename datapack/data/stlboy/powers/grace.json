{
 "type": "apoli:multiple",
 "name": "Firmament's Grace",
 "description": "§7§oThe stars watch over you as one of their own. Beneath their gaze your hands grow §e§oquick§7§o; but deep in the bowels of the earth, far from their light, your glow §8§odims§7§o and dies.",
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/gauge.png",
   "text": "§eGrace§7 rises under open sky, §ffaster at night§7, §dfar faster in the End§7. It falls underground and in the §cNether§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/tool.png",
   "text": "§aHigh Grace → Haste§7, §eHaste I§7, §eHaste II§7 in the End."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": {
    "translate": "badge.stlboy.grace.2",
    "fallback": "§cLow Grace§7 → Mining Fatigue. Far from the stars, a §fsoft starglow§7 lights your way."
   }
  }
 ],
