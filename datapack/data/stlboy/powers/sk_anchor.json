{
 "type": "apoli:multiple",
 "mark": {
  "type": "apoli:action_over_time",
  "interval": 20,
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:stardust_rank",
    "comparison": ">=",
    "compare_to": 2
   },
   "if_action": {
    "type": "apoli:execute_command",
    "command": "tag @s add stlboy_sk_anchor"
   },
   "else_action": {
    "type": "apoli:execute_command",
    "command": "tag @s remove stlboy_sk_anchor"
   }
  }
 },
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/skill.png",
   "text": {
    "translate": "badge.stlboy.sk_anchor.0",
    "fallback": "§eV§7 → place the held block in mid-air where you look. §8(Rank 2+)"
   }
  }
 ],
 "hidden": true
}