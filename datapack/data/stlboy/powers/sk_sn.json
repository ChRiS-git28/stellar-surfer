{
 "type": "apoli:multiple",
 "mark": {
  "type": "apoli:action_over_time",
  "interval": 20,
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:stardust_rank",
    "comparison": ">=",
    "compare_to": 7
   },
   "if_action": {
    "type": "apoli:execute_command",
    "command": "tag @s add stlboy_sk_sn"
   },
   "else_action": {
    "type": "apoli:execute_command",
    "command": "tag @s remove stlboy_sk_sn"
   }
  }
 },
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/skill.png",
   "text": {
    "translate": "badge.stlboy.sk_sn.0",
    "fallback": "§eCrash White Hole into Black Hole§7 → §dWormhole§7: a 10-block field, foes slowed, blinded, no teleports. §8(Rank 7+)"
   }
  }
 ]
}