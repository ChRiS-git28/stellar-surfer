{
 "type": "apoli:multiple",
 "name": {
  "translate": "power.stlboy.star_anchor.name",
  "fallback": "Star Anchor"
 },
 "description": {
  "translate": "power.stlboy.star_anchor.description",
  "fallback": "You cannot sleep: the night is your home. Hold still beneath an open sky and trace your own constellation among the stars; they will remember where you stood."
 },
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/star.png",
   "text": {
    "translate": "badge.stlboy.star_anchor.0",
    "fallback": "§7Hold the §fStar Anchor§7 key (default §fB§7) and stay §fstill§7 under an open sky: §fthree stars§7 appear above you. Hold your gaze on each one until it §6ignites§7. When all three shine, your §brespawn point§7 is set here. Releasing the key or moving breaks the ritual. Overworld only, not while surfing or §cHunted§7."
   }
  }
 ],
 "charge": {
  "type": "apoli:resource",
  "min": 0,
  "max": 400,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "cd": {
  "type": "apoli:resource",
  "min": 0,
  "max": 200,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "cool": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:star_anchor_cd",
   "comparison": ">",
   "compare_to": 0
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:star_anchor_cd",
   "change": -1,
   "operation": "add"
  }
 },
 "ritual": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:and",
    "conditions": [
     {
      "type": "apoli:exposed_to_sky"
     },
     {
      "type": "apoli:dimension",
      "dimension": "minecraft:overworld"
     },
     {
      "type": "apoli:resource",
      "resource": "stlboy:star_anchor_hold",
      "comparison": ">",
      "compare_to": 0
     },
     {
      "type": "apoli:resource",
      "resource": "stlboy:star_anchor_cd",
      "comparison": "==",
      "compare_to": 0
     },
     {
      "type": "apoli:resource",
      "resource": "stlboy:hunted_timer",
      "comparison": "==",
      "compare_to": 0
     },
     {
      "type": "apoli:resource",
      "resource": "stlboy:flight_armed",
      "comparison": "<",
      "compare_to": 1
     },
     {
      "type": "apoli:moving",
      "inverted": true
     },
     {
      "type": "apoli:resource",
      "resource": "stlboy:stellar_breath_charge",
      "comparison": "==",
      "compare_to": 0
     }
    ]
   },
   "if_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:execute_command",
      "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
     },
     {
      "type": "apoli:execute_command",
      "command": "function stlboy:anchor/charge"
     }
    ]
   },
   "else_action": {
    "type": "apoli:if_else",
    "condition": {
     "type": "apoli:resource",
     "resource": "stlboy:star_anchor_charge",
     "comparison": ">",
     "compare_to": 0
    },
    "if_action": {
     "type": "apoli:and",
     "actions": [
      {
       "type": "apoli:execute_command",
       "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
      },
      {
       "type": "apoli:execute_command",
       "command": "function stlboy:anchor/cancel"
      }
     ]
    }
   }
  }
 },
 "hold": {
  "type": "apoli:resource",
  "min": 0,
  "max": 3,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "key": {
  "type": "apoli:action_on_key_press",
  "cooldown": 1,
  "key": {
   "key": "key.stlboy.anchor",
   "continuous": true
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:star_anchor_hold",
   "change": 3,
   "operation": "set"
  }
 },
 "hold_decay": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:star_anchor_hold",
   "comparison": ">",
   "compare_to": 0
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:star_anchor_hold",
   "change": -1,
   "operation": "add"
  }
 }
}
