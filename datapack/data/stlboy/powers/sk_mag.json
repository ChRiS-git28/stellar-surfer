{
 "type": "apoli:multiple",
 "mark": {
  "type": "apoli:action_over_time",
  "interval": 20,
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:stardust_rank",
    "comparison": ">=",
    "compare_to": 1
   },
   "if_action": {
    "type": "apoli:execute_command",
    "command": "tag @s add stlboy_sk_mag"
   },
   "else_action": {
    "type": "apoli:execute_command",
    "command": "tag @s remove stlboy_sk_mag"
   }
  }
 },
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/skill.png",
   "text": {
    "translate": "badge.stlboy.sk_mag.0",
    "fallback": "§7Unlocks the §bitem magnet§7 (§eTab§7 toggles it). §f+1§7 block reach. §8(Rank 1+)"
   }
  }
 ],
 "hidden": true
}