{
 "type": "apoli:multiple",
 "name": "Stardust Sources",
 "ore": {
  "type": "apoli:action_on_block_break",
  "only_when_harvested": true,
  "block_condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:in_tag",
     "tag": "c:ores"
    },
    {
     "type": "apoli:block",
     "block": "minecraft:ancient_debris",
     "inverted": true
    }
   ]
  },
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:stardust_rank",
    "comparison": "<=",
    "compare_to": 3
   },
   "if_action": {
    "type": "apoli:change_resource",
    "resource": "stlboy:stardust_gain",
    "change": 2,
    "operation": "add"
   }
  }
 },
