{
 "type": "apoli:multiple",
 "mark": {
  "type": "apoli:action_over_time",
  "interval": 20,
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:stardust_rank",
    "comparison": ">=",
    "compare_to": 5
   },
   "if_action": {
    "type": "apoli:execute_command",
    "command": "tag @s add stlboy_sk_nova"
   },
   "else_action": {
    "type": "apoli:execute_command",
    "command": "tag @s remove stlboy_sk_nova"
   }
  }
 },
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/skill.png",
   "text": {
    "translate": "badge.stlboy.sk_nova.0",
    "fallback": "§eHold C§7 → summon & steer a §bWhite Hole§7: repels foes, reflects projectiles. §8(Rank 5+)"
   }
  }
 ]
}