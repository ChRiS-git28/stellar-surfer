{
 "type": "apoli:multiple",
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/star.png",
   "text": {
    "translate": "badge.stlboy.shard.0",
    "fallback": "§eX§7 → loose a §dStar Shard§7: instant, homes on the nearest foe ahead, §f2 hearts§7 of cosmic damage. §f3§7 charges (§f5§7 at Rank 10), one back every §f2 s§7. Never interrupted."
   }
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/star.png",
   "text": {
    "translate": "badge.stlboy.shard.cls",
    "fallback": ""
   }
  }
 ],
 "charges": {
  "type": "apoli:resource",
  "min": 0,
  "max": 5,
  "start_value": 3,
  "hud_render": {
   "should_render": false
  }
 },
 "cast": {
  "type": "apoli:action_on_key_press",
  "cooldown": 4,
  "key": {
   "key": "key.stlboy.shard"
  },
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:shard_charges",
    "comparison": ">",
    "compare_to": 0
   },
   "if_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:if_else",
      "condition": {
       "type": "apoli:power",
       "power": "stlboy:sk_ray_rain"
      },
      "if_action": {
       "type": "apoli:exhaust",
       "amount": 2.5
      },
      "else_action": {
       "type": "apoli:exhaust",
       "amount": 2.0
      }
     },
     {
      "type": "apoli:and",
      "actions": [
       {
        "type": "apoli:execute_command",
        "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
       },
       {
        "type": "apoli:execute_command",
        "command": "function stlboy:shard/cast"
       }
      ]
     }
    ]
   },
   "else_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:execute_command",
      "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
     },
     {
      "type": "apoli:execute_command",
      "command": "function stlboy:shard/cast"
     }
    ]
   }
  }
 },
 "regen": {
  "type": "apoli:action_over_time",
  "interval": 40,
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:shard_charges",
     "comparison": "<",
     "compare_to": 3
    },
    {
     "type": "apoli:power",
     "power": "stlboy:sk_ray_rain",
     "inverted": true
    },
    {
     "type": "apoli:resource",
     "resource": "stlboy:stardust_rank",
     "comparison": "<",
     "compare_to": 10
    }
   ]
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:shard_charges",
   "change": 1,
   "operation": "add"
  }
 },
 "regen_rain": {
  "type": "apoli:action_over_time",
  "interval": 20,
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:shard_charges",
     "comparison": "<",
     "compare_to": 5
    },
    {
     "type": "apoli:power",
     "power": "stlboy:sk_ray_rain"
    }
   ]
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:shard_charges",
   "change": 1,
   "operation": "add"
  }
 },
 "fly": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
    },
    {
     "type": "apoli:execute_command",
     "command": "execute as @e[type=minecraft:item_display,tag=stlboy_shard,predicate=stlboy:owned] at @s run function stlboy:shard/step"
    }
   ]
  }
 },
 "regen_r10": {
  "type": "apoli:action_over_time",
  "interval": 40,
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:shard_charges",
     "comparison": "<",
     "compare_to": 5
    },
    {
     "type": "apoli:resource",
     "resource": "stlboy:stardust_rank",
     "comparison": ">=",
     "compare_to": 10
    },
    {
     "type": "apoli:power",
     "power": "stlboy:sk_ray_rain",
     "inverted": true
    }
   ]
  },
  "entity_action": {
   "type": "apoli:change_resource",
   "resource": "stlboy:shard_charges",
   "change": 1,
   "operation": "add"
  }
 }
}