{
 "type": "apoli:multiple",
 "name": "Earthly Repulsion",
 "description": "§7§oThe earth rejects you like a foreign body. Every touch of matter sets your essence ringing with a painful §c§odissonance§7§o — and the longer you linger, the deeper it tears.",
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/passive.png",
   "text": "§7Touching a block makes you §eunstable§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/warn.png",
   "text": "§eUnstable§7 → steady magic damage."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": "§c§lCritical§7 → double damage, §8Weakness§7 & §8Slowness§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/info.png",
   "text": "§7Keep §fclear of everything§7 to steady yourself."
  }
 ],
 "timer": {
  "type": "apoli:resource",
  "min": 0,
  "max": 60,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "tick_timer": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:or",
    "conditions": [
     {
      "type": "apoli:block_collision",
      "offset_x": 0,
      "offset_y": -0.05,
      "offset_z": 0
     },
     {
      "type": "apoli:block_collision",
      "offset_x": 0,
      "offset_y": 0.05,
      "offset_z": 0
     },
     {
      "type": "apoli:block_collision",
      "offset_x": 0.05,
      "offset_y": 0,
      "offset_z": 0
     },
     {
      "type": "apoli:block_collision",
      "offset_x": -0.05,
      "offset_y": 0,
      "offset_z": 0
     },
     {
      "type": "apoli:block_collision",
      "offset_x": 0,
      "offset_y": 0,
      "offset_z": 0.05
     },
     {
      "type": "apoli:block_collision",
      "offset_x": 0,
      "offset_y": 0,
      "offset_z": -0.05
     }
    ]
   },
   "if_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:change_resource",
      "resource": "stlboy:repul_timer",
      "change": 1,
      "operation": "add"
     },
     {
      "type": "apoli:if_else",
      "condition": {
       "type": "apoli:resource",
       "resource": "stlboy:repul_pulse",
       "comparison": "==",
       "compare_to": 0
      },
      "if_action": {
       "type": "apoli:and",
       "actions": [
        {
         "type": "apoli:if_else",
         "condition": {
          "type": "apoli:resource",
          "resource": "stlboy:repul_timer",
          "comparison": ">=",
          "compare_to": 40
         },
         "if_action": {
          "type": "apoli:execute_command",
          "command": "damage @s 4 minecraft:magic"
         },
         "else_action": {
          "type": "apoli:execute_command",
          "command": "damage @s 2 minecraft:magic"
         }
        },
        {
         "type": "apoli:change_resource",
         "resource": "stlboy:repul_pulse",
         "change": 10,
         "operation": "set"
        }
       ]
      },
      "else_action": {
       "type": "apoli:change_resource",
       "resource": "stlboy:repul_pulse",
       "change": -1,
       "operation": "add"
      }
     }
    ]
   },
   "else_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:change_resource",
      "resource": "stlboy:repul_timer",
      "change": -3,
      "operation": "add"
     },
     {
      "type": "apoli:change_resource",
      "resource": "stlboy:repul_pulse",
      "change": 0,
      "operation": "set"
     }
    ]
   }
  }
 },
 "weakening": {
  "type": "apoli:action_over_time",
  "interval": 10,
  "entity_action": {
   "type": "apoli:apply_effect",
   "effects": [
    {
     "effect": "minecraft:weakness",
     "duration": 30,
     "amplifier": 0,
     "is_ambient": true,
     "show_particles": false,
     "show_icon": true
    },
    {
     "effect": "minecraft:slowness",
     "duration": 30,
     "amplifier": 0,
     "is_ambient": true,
     "show_particles": false,
     "show_icon": true
    }
   ]
  },
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:repul_timer",
   "comparison": ">=",
   "compare_to": 40
  }
 },
 "feedback_particles": {
  "type": "apoli:action_over_time",
  "interval": 5,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:repul_timer",
   "comparison": ">=",
   "compare_to": 1
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "particle minecraft:enchant ~ ~1 ~ 0.5 0.7 0.5 0.5 12"
    },
    {
     "type": "apoli:execute_command",
     "command": "particle minecraft:end_rod ~ ~1 ~ 0.4 0.6 0.4 0.05 3"
    }
   ]
  }
 },
 "feedback_sound": {
  "type": "apoli:action_over_time",
  "interval": 10,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:repul_timer",
   "comparison": ">=",
   "compare_to": 1
  },
  "entity_action": {
   "type": "apoli:execute_command",
   "command": "playsound minecraft:entity.allay.hurt player @a ~ ~ ~ 1 1"
  }
 },
 "feedback_alarm": {
  "type": "apoli:action_over_time",
  "interval": 10,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:repul_timer",
   "comparison": ">=",
   "compare_to": 40
  },
  "entity_action": {
   "type": "apoli:execute_command",
   "command": "playsound minecraft:entity.warden.heartbeat player @s ~ ~ ~ 1.5 1.2"
  }
 },
 "pulse": {
  "type": "apoli:resource",
  "min": 0,
  "max": 10,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 }
}