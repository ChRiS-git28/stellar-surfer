{
 "type": "apoli:multiple",
 "name": "Hunted",
 "description": "§7§oStrike a star and all of creation turns its gaze upon it. Wounded, your glow betrays you: the world closes in, and every shaft loosed your way finds its path to your §c§oheart§7§o.",
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": "§7Every hit from a mob or player §cdrags you down§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/gauge.png",
   "text": "§cHunted§7 for §f3s§7 by mobs, §f8s§7 by players."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": "§cWhile Hunted:§7 movement §c÷2§7, no flight or surges, and you §eglow§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/orbit.png",
   "text": "§cWhile Hunted:§7 projectiles within §f5 blocks§7 are §cpulled into you§7."
  }
 ],
 "timer": {
  "type": "apoli:resource",
  "min": 0,
  "max": 160,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "pull": {
  "type": "apoli:resource",
  "min": 0,
  "max": 10,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "on_hit_player": {
  "type": "apoli:self_action_on_hit",
  "target_condition": {
   "type": "apoli:entity_type",
   "entity_type": "minecraft:player"
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:if_else",
     "condition": {
      "type": "apoli:resource",
      "resource": "stlboy:hunted_timer",
      "comparison": "==",
      "compare_to": 0
     },
     "if_action": {
      "type": "apoli:and",
      "actions": [
       {
        "type": "apoli:execute_command",
        "command": "playsound minecraft:entity.warden.listening_angry player @s ~ ~ ~ 0.7 1.4"
       },
       {
        "type": "apoli:execute_command",
        "command": "playsound minecraft:block.trial_spawner.ominous_activate player @a ~ ~ ~ 0.6 1.4"
       },
       {
        "type": "apoli:execute_command",
        "command": "particle minecraft:trial_spawner_detection_ominous ~ ~1.0 ~ 0.4 0.6 0.4 0 15"
       },
       {
        "type": "apoli:execute_command",
        "command": "title @s actionbar {\"text\":\"✦ Hunted ✦\",\"color\":\"red\"}"
       }
      ]
     }
    },
    {
     "type": "apoli:change_resource",
     "resource": "stlboy:hunted_timer",
     "change": 160,
     "operation": "set"
    },
    {
     "type": "apoli:apply_effect",
     "effect": {
      "effect": "minecraft:unluck",
      "duration": 160,
      "amplifier": 0,
      "is_ambient": false,
      "show_particles": false,
      "show_icon": true
     }
    }
   ]
  }
 },
 "when_hit_player": {
  "type": "apoli:self_action_when_hit",
  "damage_condition": {
   "type": "apoli:attacker",
   "entity_condition": {
    "type": "apoli:entity_type",
    "entity_type": "minecraft:player"
   }
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:and",
     "actions": [
      {
       "type": "apoli:if_else",
       "condition": {
        "type": "apoli:resource",
        "resource": "stlboy:hunted_timer",
        "comparison": "==",
        "compare_to": 0
       },
       "if_action": {
        "type": "apoli:and",
        "actions": [
         {
          "type": "apoli:execute_command",
          "command": "playsound minecraft:entity.warden.listening_angry player @s ~ ~ ~ 0.7 1.4"
         },
         {
          "type": "apoli:execute_command",
          "command": "playsound minecraft:block.trial_spawner.ominous_activate player @a ~ ~ ~ 0.6 1.4"
         },
         {
          "type": "apoli:execute_command",
          "command": "particle minecraft:trial_spawner_detection_ominous ~ ~1.0 ~ 0.4 0.6 0.4 0 15"
         },
         {
          "type": "apoli:execute_command",
          "command": "title @s actionbar {\"text\":\"✦ Hunted ✦\",\"color\":\"red\"}"
         }
        ]
       }
      },
      {
       "type": "apoli:change_resource",
       "resource": "stlboy:hunted_timer",
       "change": 160,
       "operation": "set"
      },
      {
       "type": "apoli:apply_effect",
       "effect": {
        "effect": "minecraft:unluck",
        "duration": 160,
        "amplifier": 0,
        "is_ambient": false,
        "show_particles": false,
        "show_icon": true
       }
      }
     ]
    },
    {
     "type": "apoli:and",
     "actions": [
      {
       "type": "apoli:add_velocity",
       "space": "world",
       "y": -0.5
      },
      {
       "type": "apoli:change_resource",
       "resource": "stlboy:hunted_pull",
       "change": 10,
       "operation": "set"
      },
      {
       "type": "apoli:change_resource",
       "resource": "stlboy:flight_level",
       "change": 0,
       "operation": "set"
      },
      {
       "type": "apoli:execute_command",
       "command": "particle minecraft:dust{color:[0.9,0.12,0.25],scale:1.2} ~ ~1 ~ 0.3 0.5 0.3 0 15"
      }
     ]
    },
    {
     "type": "apoli:execute_command",
     "command": "playsound minecraft:entity.shulker_bullet.hit player @a ~ ~ ~ 0.6 0.6"
    }
   ]
  }
 },
 "when_hit_mob": {
  "type": "apoli:self_action_when_hit",
  "damage_condition": {
   "type": "apoli:attacker",
   "entity_condition": {
    "type": "apoli:entity_type",
    "entity_type": "minecraft:player",
    "inverted": true
   }
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:and",
     "actions": [
      {
       "type": "apoli:if_else",
       "condition": {
        "type": "apoli:resource",
        "resource": "stlboy:hunted_timer",
        "comparison": "==",
        "compare_to": 0
       },
       "if_action": {
        "type": "apoli:and",
        "actions": [
         {
          "type": "apoli:execute_command",
          "command": "playsound minecraft:entity.warden.listening_angry player @s ~ ~ ~ 0.7 1.4"
         },
         {
          "type": "apoli:execute_command",
          "command": "playsound minecraft:block.trial_spawner.ominous_activate player @a ~ ~ ~ 0.6 1.4"
         },
         {
          "type": "apoli:execute_command",
          "command": "particle minecraft:trial_spawner_detection_ominous ~ ~1.0 ~ 0.4 0.6 0.4 0 15"
         },
         {
          "type": "apoli:execute_command",
          "command": "title @s actionbar {\"text\":\"✦ Hunted ✦\",\"color\":\"red\"}"
         }
        ]
       }
      },
      {
       "type": "apoli:if_else",
       "condition": {
        "type": "apoli:resource",
        "resource": "stlboy:hunted_timer",
        "comparison": "<",
        "compare_to": 60
       },
       "if_action": {
        "type": "apoli:and",
        "actions": [
         {
          "type": "apoli:change_resource",
          "resource": "stlboy:hunted_timer",
          "change": 60,
          "operation": "set"
         },
         {
          "type": "apoli:apply_effect",
          "effect": {
           "effect": "minecraft:unluck",
           "duration": 60,
           "amplifier": 0,
           "is_ambient": false,
           "show_particles": false,
           "show_icon": true
          }
         }
        ]
       }
      }
     ]
    },
    {
     "type": "apoli:and",
     "actions": [
      {
       "type": "apoli:add_velocity",
       "space": "world",
       "y": -0.5
      },
      {
       "type": "apoli:change_resource",
       "resource": "stlboy:hunted_pull",
       "change": 10,
       "operation": "set"
      },
      {
       "type": "apoli:change_resource",
       "resource": "stlboy:flight_level",
       "change": 0,
       "operation": "set"
      },
      {
       "type": "apoli:execute_command",
       "command": "particle minecraft:dust{color:[0.9,0.12,0.25],scale:1.2} ~ ~1 ~ 0.3 0.5 0.3 0 15"
      }
     ]
    },
    {
     "type": "apoli:execute_command",
     "command": "playsound minecraft:entity.shulker_bullet.hit player @a ~ ~ ~ 0.6 0.6"
    }
   ]
  }
 },
 "tick": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:if_else",
     "condition": {
      "type": "apoli:resource",
      "resource": "stlboy:hunted_timer",
      "comparison": ">",
      "compare_to": 0
     },
     "if_action": {
      "type": "apoli:change_resource",
      "resource": "stlboy:hunted_timer",
      "change": -1,
      "operation": "add"
     }
    },
    {
     "type": "apoli:if_else",
     "condition": {
      "type": "apoli:resource",
      "resource": "stlboy:hunted_pull",
      "comparison": ">",
      "compare_to": 0
     },
     "if_action": {
      "type": "apoli:and",
      "actions": [
       {
        "type": "apoli:change_resource",
        "resource": "stlboy:hunted_pull",
        "change": -1,
        "operation": "add"
       },
       {
        "type": "apoli:add_velocity",
        "space": "world",
        "y": -0.04
       }
      ]
     }
    }
   ]
  }
 },
 "half_forward": {
  "type": "apoli:action_on_key_press",
  "cooldown": 1,
  "key": {
   "key": "key.forward",
   "continuous": true
  },
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:hunted_timer",
     "comparison": ">",
     "compare_to": 0
    },
    {
     "type": "apoli:on_block",
     "inverted": true
    }
   ]
  },
  "entity_action": {
   "type": "apoli:add_velocity",
   "space": "local_horizontal_normalized",
   "z": -0.008
  }
 },
 "half_back": {
  "type": "apoli:action_on_key_press",
  "cooldown": 1,
  "key": {
   "key": "key.back",
   "continuous": true
  },
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:hunted_timer",
     "comparison": ">",
     "compare_to": 0
    },
    {
     "type": "apoli:on_block",
     "inverted": true
    }
   ]
  },
  "entity_action": {
   "type": "apoli:add_velocity",
   "space": "local_horizontal_normalized",
   "z": 0.008
  }
 },
 "half_left": {
  "type": "apoli:action_on_key_press",
  "cooldown": 1,
  "key": {
   "key": "key.left",
   "continuous": true
  },
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:hunted_timer",
     "comparison": ">",
     "compare_to": 0
    },
    {
     "type": "apoli:on_block",
     "inverted": true
    }
   ]
  },
  "entity_action": {
   "type": "apoli:add_velocity",
   "space": "local_horizontal_normalized",
   "x": -0.008
  }
 },
 "half_right": {
  "type": "apoli:action_on_key_press",
  "cooldown": 1,
  "key": {
   "key": "key.right",
   "continuous": true
  },
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:hunted_timer",
     "comparison": ">",
     "compare_to": 0
    },
    {
     "type": "apoli:on_block",
     "inverted": true
    }
   ]
  },
  "entity_action": {
   "type": "apoli:add_velocity",
   "space": "local_horizontal_normalized",
   "x": 0.008
  }
 },
 "glow": {
  "type": "apoli:action_over_time",
  "interval": 10,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:hunted_timer",
   "comparison": ">",
   "compare_to": 0
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:apply_effect",
     "effect": {
      "effect": "minecraft:glowing",
      "duration": 15,
      "amplifier": 0,
      "is_ambient": true,
      "show_particles": false,
      "show_icon": true
     }
    },
    {
     "type": "apoli:execute_command",
     "command": "particle minecraft:dust{color:[0.9,0.12,0.25],scale:1.2} ~ ~1.0 ~ 0.4 0.6 0.4 0 6"
    }
   ]
  }
 },
 "clear_end": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:hunted_timer",
   "comparison": "==",
   "compare_to": 1
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "effect clear @s minecraft:unluck"
    },
    {
     "type": "apoli:execute_command",
     "command": "playsound stlboy:cosmic.off player @s ~ ~ ~ 0.6 1.3"
    },
    {
     "type": "apoli:execute_command",
     "command": "particle minecraft:end_rod ~ ~1.0 ~ 0.3 0.5 0.3 0.05 10"
    }
   ]
  }
 },
 "projectile_magnet": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:hunted_timer",
   "comparison": ">",
   "compare_to": 0
  },
  "entity_action": {
   "type": "apoli:area_of_effect",
   "radius": 5,
   "shape": "sphere",
   "include_actor": false,
   "bientity_condition": {
    "type": "apoli:target_condition",
    "condition": {
     "type": "apoli:in_tag",
     "tag": "stlboy:homing_projectiles"
    }
   },
   "bientity_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:add_velocity",
      "reference": "position",
      "z": -1.2,
      "set": true
     },
     {
      "type": "apoli:target_action",
      "action": {
       "type": "apoli:execute_command",
       "command": "particle minecraft:electric_spark ~ ~ ~ 0.05 0.05 0.05 0 1"
      }
     }
    ]
   }
  }
 }
}